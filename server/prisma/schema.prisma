generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum IdentityStatus {
  ACTIVE
  INVITED
  DISABLED
  REVOKED
}

enum RoleName {
  ROOT
  MAINTAINER
  SUPER_ADMIN
  ADMIN
  PRESENTER
  USER
}

enum RoleScope {
  PLATFORM
  COMMUNITY
  EVENT
}

enum MembershipStatus {
  ACTIVE
  INVITED
  LEFT
  REMOVED
}

enum CommunityVisibility {
  PUBLIC
  PRIVATE
}

enum GroupVisibility {
  PUBLIC
  PRIVATE
}

enum BroadcastStatus {
  DRAFT
  SCHEDULED
  LIVE
  ENDED
  CANCELLED
}

enum RsvpStatus {
  GOING
  NOT_GOING
}

enum ConversationType {
  COMMUNITY
  DIRECT
  EVENT
  GROUP
}

enum ChannelVisibility {
  PUBLIC
  PRIVATE
}

enum AvatarTone {
  INK
  BLUE
  CORAL
  ORANGE
  PLUM
  SAGE
  VIOLET
}

model User {
  id          String         @id @default(cuid()) @db.VarChar(64)
  handle      String         @unique @db.VarChar(32)
  displayName String         @db.VarChar(120)
  initials    String         @db.VarChar(8)
  avatarTone  AvatarTone     @default(INK)
  email       String?        @unique @db.VarChar(320)
  status      IdentityStatus @default(INVITED)
  createdAt   DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime       @updatedAt @db.Timestamptz(3)

  roleAssignments         RoleAssignment[]
  memberships             CommunityMember[]
  createdEvents           Event[]                   @relation("EventCreator")
  rsvps                   EventRsvp[]
  conversationMemberships ConversationParticipant[]
  messages                Message[]
  auditEvents             AuditLog[]                @relation("AuditActor")
  idempotencyRecords      IdempotencyRecord[]
  passwordCredential      PasswordCredential?
  sessions                Session[]
  oidcIdentities          OidcIdentity[]
  createdGroups           Group[]                   @relation("GroupCreator")
  groupMemberships        GroupMember[]
  posts                   Post[]
  broadcasts              Broadcast[]
  createdConversations    Conversation[]            @relation("ConversationCreator")

  @@index([displayName, id])
}

model PasswordCredential {
  userId       String   @id @db.VarChar(64)
  passwordHash String   @db.VarChar(255)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Session {
  id         String    @id @default(cuid()) @db.VarChar(64)
  tokenHash  String    @unique @db.Char(64)
  userId     String    @db.VarChar(64)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  expiresAt  DateTime  @db.Timestamptz(3)
  lastSeenAt DateTime  @default(now()) @db.Timestamptz(3)
  revokedAt  DateTime? @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt, revokedAt])
}

model OidcIdentity {
  issuer      String   @db.VarChar(500)
  subject     String   @db.VarChar(255)
  userId      String   @db.VarChar(64)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  lastLoginAt DateTime @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([issuer, subject])
  @@unique([userId, issuer])
  @@index([userId])
}

model OidcFlow {
  stateHash    String   @id @db.Char(64)
  codeVerifier String   @db.VarChar(128)
  nonce        String   @db.VarChar(128)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  expiresAt    DateTime @db.Timestamptz(3)

  @@index([expiresAt])
}

model Community {
  id          String              @id @default(cuid()) @db.VarChar(64)
  slug        String              @unique @db.VarChar(80)
  name        String              @db.VarChar(120)
  description String              @db.VarChar(1000)
  visibility  CommunityVisibility @default(PUBLIC)
  createdAt   DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime            @updatedAt @db.Timestamptz(3)

  memberships     CommunityMember[]
  roleAssignments RoleAssignment[]
  events          Event[]
  conversations   Conversation[]
  auditEvents     AuditLog[]
  groups          Group[]
  posts           Post[]
  broadcasts      Broadcast[]

  @@index([name, id])
}

model Group {
  id          String          @id @default(cuid()) @db.VarChar(64)
  communityId String          @db.VarChar(64)
  slug        String          @db.VarChar(80)
  name        String          @db.VarChar(120)
  description String          @db.VarChar(1000)
  visibility  GroupVisibility @default(PUBLIC)
  createdById String          @db.VarChar(64)
  createdAt   DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime        @updatedAt @db.Timestamptz(3)
  deletedAt   DateTime?       @db.Timestamptz(3)

  community     Community      @relation(fields: [communityId], references: [id], onDelete: Cascade)
  createdBy     User           @relation("GroupCreator", fields: [createdById], references: [id], onDelete: Restrict)
  members       GroupMember[]
  posts         Post[]
  broadcasts    Broadcast[]
  conversations Conversation[]

  @@unique([communityId, slug])
  @@index([communityId, createdAt, id])
  @@index([communityId, visibility, deletedAt])
}

model Post {
  id          String    @id @default(cuid()) @db.VarChar(64)
  communityId String    @db.VarChar(64)
  groupId     String?   @db.VarChar(64)
  authorId    String    @db.VarChar(64)
  body        String    @db.VarChar(10000)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt   DateTime? @db.Timestamptz(3)

  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  group     Group?    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  author    User      @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([communityId, createdAt, id])
  @@index([groupId, createdAt, id])
  @@index([authorId, createdAt])
  @@index([communityId, deletedAt, createdAt])
}

model Broadcast {
  id          String          @id @default(cuid()) @db.VarChar(64)
  communityId String          @db.VarChar(64)
  groupId     String?         @db.VarChar(64)
  authorId    String          @db.VarChar(64)
  title       String          @db.VarChar(160)
  body        String          @db.VarChar(5000)
  status      BroadcastStatus @default(DRAFT)
  startsAt    DateTime?       @db.Timestamptz(3)
  endsAt      DateTime?       @db.Timestamptz(3)
  createdAt   DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime        @updatedAt @db.Timestamptz(3)
  deletedAt   DateTime?       @db.Timestamptz(3)

  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  group     Group?    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  author    User      @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([communityId, startsAt, id])
  @@index([groupId, startsAt, id])
  @@index([communityId, status, deletedAt])
  @@index([authorId, createdAt])
}

model GroupMember {
  groupId   String           @db.VarChar(64)
  userId    String           @db.VarChar(64)
  status    MembershipStatus @default(ACTIVE)
  joinedAt  DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt DateTime         @updatedAt @db.Timestamptz(3)

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([groupId, userId])
  @@index([userId, status])
}

model CommunityMember {
  communityId String           @db.VarChar(64)
  userId      String           @db.VarChar(64)
  status      MembershipStatus @default(ACTIVE)
  joinedAt    DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @db.Timestamptz(3)

  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([communityId, userId])
  @@index([userId, status])
}

model RoleAssignment {
  id          String    @id @default(cuid()) @db.VarChar(64)
  userId      String    @db.VarChar(64)
  role        RoleName
  scope       RoleScope
  communityId String?   @db.VarChar(64)
  eventId     String?   @db.VarChar(64)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  community Community? @relation(fields: [communityId], references: [id], onDelete: Cascade)
  event     Event?     @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([userId, scope])
  @@index([communityId, role])
  @@index([eventId, role])
}

model Event {
  id          String   @id @default(cuid()) @db.VarChar(64)
  communityId String   @db.VarChar(64)
  slug        String   @db.VarChar(100)
  title       String   @db.VarChar(160)
  description String   @db.VarChar(2000)
  startsAt    DateTime @db.Timestamptz(3)
  endsAt      DateTime @db.Timestamptz(3)
  location    String   @db.VarChar(240)
  createdById String   @db.VarChar(64)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  community       Community        @relation(fields: [communityId], references: [id], onDelete: Cascade)
  createdBy       User             @relation("EventCreator", fields: [createdById], references: [id], onDelete: Restrict)
  roleAssignments RoleAssignment[]
  rsvps           EventRsvp[]
  auditEvents     AuditLog[]

  @@unique([communityId, slug])
  @@index([communityId, startsAt])
  @@index([startsAt, id])
}

model EventRsvp {
  eventId   String     @db.VarChar(64)
  userId    String     @db.VarChar(64)
  status    RsvpStatus
  createdAt DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt DateTime   @updatedAt @db.Timestamptz(3)

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([eventId, userId])
  @@index([userId, updatedAt])
}

model Conversation {
  id          String            @id @default(cuid()) @db.VarChar(64)
  communityId String            @db.VarChar(64)
  groupId     String?           @db.VarChar(64)
  directKey   String?           @unique @db.Char(64)
  slug        String?           @db.VarChar(80)
  title       String            @db.VarChar(160)
  description String            @default("") @db.VarChar(1000)
  type        ConversationType
  visibility  ChannelVisibility @default(PRIVATE)
  createdById String?           @db.VarChar(64)
  createdAt   DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime          @updatedAt @db.Timestamptz(3)
  deletedAt   DateTime?         @db.Timestamptz(3)

  community    Community                 @relation(fields: [communityId], references: [id], onDelete: Cascade)
  group        Group?                    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdBy    User?                     @relation("ConversationCreator", fields: [createdById], references: [id], onDelete: Restrict)
  participants ConversationParticipant[]
  messages     Message[]

  @@unique([communityId, slug])
  @@index([communityId, updatedAt])
  @@index([updatedAt, id])
  @@index([groupId, updatedAt])
  @@index([communityId, visibility, deletedAt])
}

model ConversationParticipant {
  conversationId String    @db.VarChar(64)
  userId         String    @db.VarChar(64)
  joinedAt       DateTime  @default(now()) @db.Timestamptz(3)
  lastReadAt     DateTime? @db.Timestamptz(3)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@index([userId, joinedAt])
}

model Message {
  id             String    @id @default(cuid()) @db.VarChar(64)
  conversationId String    @db.VarChar(64)
  authorId       String    @db.VarChar(64)
  body           String    @db.VarChar(4000)
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  editedAt       DateTime? @db.Timestamptz(3)
  deletedAt      DateTime? @db.Timestamptz(3)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  author       User         @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([conversationId, createdAt, id])
  @@index([conversationId, createdAt], map: "Message_conversationId_createdAt_idx")
  @@index([authorId, createdAt])
}

model AuditLog {
  id             String   @id @default(cuid()) @db.VarChar(64)
  actorUserId    String   @db.VarChar(64)
  action         String   @db.VarChar(120)
  targetType     String   @db.VarChar(80)
  targetId       String   @db.VarChar(64)
  communityId    String?  @db.VarChar(64)
  eventId        String?  @db.VarChar(64)
  idempotencyKey String?  @db.VarChar(128)
  metadata       Json
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  actor     User       @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  community Community? @relation(fields: [communityId], references: [id], onDelete: SetNull)
  event     Event?     @relation(fields: [eventId], references: [id], onDelete: SetNull)

  @@index([actorUserId, createdAt])
  @@index([communityId, createdAt])
  @@index([targetType, targetId, createdAt])
  @@index([createdAt, id])
}

model IdempotencyRecord {
  id          String   @id @default(cuid()) @db.VarChar(64)
  actorUserId String   @db.VarChar(64)
  key         String   @db.VarChar(128)
  action      String   @db.VarChar(120)
  requestHash String   @db.Char(64)
  statusCode  Int
  response    Json
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  expiresAt   DateTime @db.Timestamptz(3)

  actor User @relation(fields: [actorUserId], references: [id], onDelete: Cascade)

  @@unique([actorUserId, key, action])
  @@index([expiresAt])
}
