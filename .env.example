# Kommunity runs locally without any API keys.
# Copy this file only when enabling the optional production integrations below.

# Public app URL
VITE_APP_URL=http://127.0.0.1:4173

# Optional production authentication (not used by the local demo)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# Optional transactional email
RESEND_API_KEY=
EMAIL_FROM=Kommunity <hello@example.com>

# Optional production database and object storage
DATABASE_URL=
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Required in a production API deployment; generate at least 32 random bytes
AUTH_SECRET=
QR_SIGNING_SECRET=
