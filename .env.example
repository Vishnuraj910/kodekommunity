# Kommunity runs locally without any API keys.
# Copy this file only when enabling the future production server.
# Never expose values below through a VITE_ prefix. VITE_ values are public and
# bundled into browser JavaScript.

# Public app URL
VITE_APP_URL=http://127.0.0.1:4173

# Future server-only authentication (not used by the local demo)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# Future server-only transactional email
RESEND_API_KEY=
EMAIL_FROM=Kommunity <hello@example.com>

# Future server-only production database and object storage
DATABASE_URL=
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Future server-only signing material. Generate separate values with at least
# 32 random bytes and load them from a managed secret store.
AUTH_SECRET=
QR_SIGNING_SECRET=
