# Kommunity's local email/password stack runs without third-party API keys.
# Copy this file to server/.env and replace the local database credentials.
# Never expose values below through a VITE_ prefix. VITE_ values are public and
# bundled into browser JavaScript.

# Public app URL
VITE_APP_URL=http://127.0.0.1:4173

# Local Fastify/PostgreSQL server
NODE_ENV=development
HOST=127.0.0.1
PORT=8787
DATABASE_URL=postgresql://YOUR_LOCAL_USER@127.0.0.1:5432/kommunity_dev?schema=public
CLIENT_ORIGIN=http://127.0.0.1:4173
SESSION_COOKIE_NAME=kommunity_session
SESSION_TTL_HOURS=12
ALLOW_DEMO_AUTH=false
LOG_LEVEL=info

# Preferred OIDC login and registration. Register one confidential web client
# with your identity provider and configure all four values together.
# OIDC_ISSUER_URL=https://identity.example.com
# OIDC_CLIENT_ID=replace-with-client-id
# OIDC_CLIENT_SECRET=replace-with-client-secret
# OIDC_REDIRECT_URI=http://127.0.0.1:8787/api/v1/auth/oidc/callback
OIDC_SCOPES=openid profile email

# Required only when running pnpm db:seed. Use one generated value of at least
# 12 characters. The database stores only a uniquely salted scrypt hash.
SEED_COMMON_PASSWORD=replace-with-a-generated-local-password
