# Kommunity's local stack runs without third-party API keys.
# Copy the server section to server/.env and replace YOUR_LOCAL_USER.
# Never expose values below through a VITE_ prefix. VITE_ values are public and
# bundled into browser JavaScript.

# Public app URL
VITE_APP_URL=http://127.0.0.1:4173

# Local Fastify/PostgreSQL server
NODE_ENV=development
HOST=127.0.0.1
PORT=8787
DATABASE_URL=postgresql://YOUR_LOCAL_USER@127.0.0.1:5432/kommunity_dev?schema=public
CLIENT_ORIGIN=http://127.0.0.1:4173
ALLOW_DEMO_AUTH=true
DEMO_USER_ID=maya
LOG_LEVEL=info

# Production server-only authentication (not used by local development)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# Future server-only transactional email
RESEND_API_KEY=
EMAIL_FROM=Kommunity <hello@example.com>

# Production server-only object storage
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Future server-only signing material. Generate separate values with at least
# 32 random bytes and load them from a managed secret store.
AUTH_SECRET=
QR_SIGNING_SECRET=
